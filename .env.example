# ---------------------------------------------------------------------------
# Task Manager - example environment variables
#
# Copy this file to `.env` and adjust the values:
#
#     cp .env.example .env
#
# The `.env` file is ignored by Git, so real credentials never reach the
# repository. The values below are the defaults used by `docker-compose.yml`
# and by the backend configuration.
# ---------------------------------------------------------------------------

# ---- PostgreSQL (Docker Compose) -----------------------------------------
# Name of the database created by the container.
POSTGRES_DB=taskdb
# User that owns the database.
POSTGRES_USER=taskuser
# Password of the database user.
# This is a local development value, NOT a production secret.
POSTGRES_PASSWORD=taskpassword
# Port published on the host. Change it if 5432 is already in use.
POSTGRES_PORT=5432

# ---- Backend ---------------------------------------------------------------
# JDBC URL of the database.
DB_URL=jdbc:postgresql://localhost:5432/taskdb
# Credentials used by the backend to connect to PostgreSQL.
DB_USERNAME=taskuser
DB_PASSWORD=taskpassword
# Port where the Spring Boot API listens.
SERVER_PORT=8080
# How Hibernate updates the schema: `update` in development, `validate` in production.
DDL_AUTO=update
# Comma separated list of origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Frontend --------------------------------------------------------------
# Base URL of the REST API. Leave it empty to use the Vite proxy in development.
VITE_API_BASE_URL=
