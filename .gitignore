# ---------------------------------------------------------------------------
# Task Manager - ignore rules
# ---------------------------------------------------------------------------

# Environment variables (never commit real secrets)
.env
.env.local
.env.*.local

# Java / Maven
target/
*.jar
*.war
*.class
.mvn/
!.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.properties

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local
.vite/
coverage/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDEs
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.project
.classpath
.settings/
nbproject/

# OS
.DS_Store
Thumbs.db
desktop.ini
